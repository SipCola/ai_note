# 后台环境配置：填写后重启后台生效。
# .env 已被 Git 忽略；.env.example 仅保留空白密钥模板，不要提交真实凭证。

# 火山引擎账号访问凭证（AK/SK），仅供后台读取，不要加 VITE_ 前缀。
# AccessKeyId 对应 VOLC_ACCESS_KEY；SecretAccessKey 对应 VOLC_SECRET_KEY。
# 命名与 rtc_basic/rag_llm_server/config.py 保持一致。
# 两项须成对填写；包含特殊字符时建议用单引号包裹整个值。
# 这是云 API 签名凭证，与火山方舟的 Bearer API Key 不同，不可混填。
# 当前 backend 使用 Bearer 适配器，以下两项先作为配置预留，尚未实现 AK/SK 签名调用。
# 仅填写这两项不会启用真实 ASR/LLM/TTS；接入方舟大模型请配置下方 LLM 三项。
# 官方鉴权说明：https://docs.volcengine.com/docs/ark/base-url-and-authentication?lang=zh
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=


# 浏览器来源白名单：多个地址用英文逗号分隔；局域网 IP 变化后需要更新。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.253.255.121:5173,https://localhost:5173,https://127.0.0.1:5173,https://10.253.255.121:5173

# 语音识别：当前仅支持 OpenAI 兼容 /audio/transcriptions 接口。
# BASE_URL、API_KEY、MODEL 三项齐全才使用真实服务，否则使用固定 Mock 识别文本。
# 火山原生语音接口的协议不同，不能直接将 AK/SK 填入 ASR_API_KEY。
ASR_BASE_URL=

# 语音识别服务的 Bearer API Key。
ASR_API_KEY=

# 语音识别模型名称。
ASR_MODEL=

# 大模型：当前使用 OpenAI 兼容 /chat/completions 接口。
# 火山方舟按量付费接口可填：https://ark.cn-beijing.volces.com/api/v3
# 使用 Coding Plan 时请改用对应套餐的专属地址。
LLM_BASE_URL=

# 填火山方舟控制台生成的 API Key（或其他兼容服务的 API Key），不是下面的 AK/SK。
LLM_API_KEY=

# 填已开通的模型 ID 或推理接入点 ID；与服务控制台保持一致。
# LLM_BASE_URL、LLM_API_KEY、LLM_MODEL 三项齐全才调用真实大模型。
LLM_MODEL=

# 语音合成：当前仅支持 OpenAI 兼容 /audio/speech 接口。
# 三项齐全才调用真实服务；否则由浏览器合成语音。
# 火山原生 TTS 需要单独适配协议，AK/SK 不能作为这里的 Bearer API Key。
TTS_BASE_URL=

# 语音合成服务的 Bearer API Key。
TTS_API_KEY=

# 语音合成模型名称。
TTS_MODEL=

# 语音合成音色标识，需要服务端支持此音色。
TTS_VOICE=alloy

# 未配置真实 ASR 时返回的固定演示文本，不是实际识别结果。
MOCK_TRANSCRIPT=你好，我想了解一下你们的服务。

# 智能客服系统提示词。
SYSTEM_PROMPT=你是一位友好、专业的中文智能客服。回答简洁，适合语音播放。不编造价格、政策或公司资料，信息不足时主动询问。
